Options -Indexes
RewriteEngine On

RewriteRule ^(app|config|logs|vendor|node_modules)(/|$) - [F,L]

<FilesMatch "^(\.env|composer\.(json|lock)|package(-lock)?\.json|tailwind\.config\.js|add_slug_to_events|check_events_table|fix_password|seed_.*|setup_.*|update_.*)\.?(php|json|lock|js)?$">
    Require all denied
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
